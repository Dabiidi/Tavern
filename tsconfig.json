{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/shared/**/*.ts",
    "src/browser/**/*.ts",
    "src/desktop/**/*.ts",
    "src/extension.ts",
    "scripts/**/*.mts",
    "test/**/*.ts"
  ]
}
