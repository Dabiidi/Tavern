{
  "name": "mosslight-meadow",
  "displayName": "Baryo \u2014 A Little Philippine Adventure",
  "description": "Explore four Filipino architecture-inspired stages with animated movement, local quests, gathering, and automatic travel.",
  "version": "0.5.0",
  "publisher": "local-cozy-games",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:mosslight.meadow"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mosslight.open",
        "title": "Baryo: Open Adventure"
      },
      {
        "command": "mosslight.popout",
        "title": "Baryo: Pop Out Game"
      },
      {
        "command": "mosslight.browser",
        "title": "Baryo: Play in Browser"
      }
    ],
    "configuration": {
      "title": "Mosslight",
      "properties": {
        "mosslight.standaloneUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4173",
          "description": "URL for the standalone game. Use the deployed site or your local preview server."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "mosslight",
          "title": "Baryo",
          "icon": "media/leaf.svg"
        }
      ]
    },
    "views": {
      "mosslight": [
        {
          "type": "webview",
          "id": "mosslight.meadow",
          "name": "Barangay Maligaya"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "typecheck": "npm run check",
    "build": "npm run check && node --import tsx scripts/build.mts",
    "watch": "node --import tsx scripts/watch.mts",
    "preview": "npm run build && node --import tsx scripts/preview.mts",
    "start": "npm run preview",
    "desktop": "npm run build && npm --prefix desktop start",
    "build:web": "npm run build && node --import tsx scripts/build-web.mts",
    "test": "npm run build && node --test dist/test/*.test.cjs",
    "vscode:prepublish": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.85.0",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
